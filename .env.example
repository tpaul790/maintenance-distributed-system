# Copy to .env and adjust. All values have the same defaults inside docker-compose.yml.
POSTGRES_DB=maintenance_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Shared HS256 secret for auth-service (signing) and api-gateway (verification). MUST be >= 32 chars.
JWT_SECRET=change-me-please-use-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=480

AUTH_SERVICE_URL=http://auth-service:8081
TENANT_SERVICE_URL=http://tenant-service:8082
UTILITY_SERVICE_URL=http://utility-service:8083

# Browser-facing URLs
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8080
